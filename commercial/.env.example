# Copy to .env and fill in. .env is gitignored; this file holds key names only
# and must never contain a real value.
#
# Display name for this edition. Not a secret. The server layout reads it and
# passes it into the page. Unset means "Trainermon".
APP_NAME=Trainermon

# Local account database. Unset uses backend/data/local.db, which is gitignored.
# Tests set this to a temporary file. No hosted database is required.
TRAINERMON_DB=

# Reserved. Default off. Friend codes are stored and are not shown to other
# trainers. Turning this on does not publish them. The contact method is undecided.
SHARE_FRIEND_CODES=

# Comma-separated emails allowed to draft and approve curated GO rows.
# Empty means nobody is an admin.
TRAINERMON_ADMINS=

# Reserved sprite switch. Default off. This build still has no sprite files.
SHOW_OFFICIAL_SPRITES=

# Optional model name for curation drafts. Unset uses deepseek-v4-flash.
# Drafting also needs ANTHROPIC_API_KEY, below. The app does not fetch the
# announcement URL.
TRAINERMON_DRAFT_MODEL=
#
# Load it explicitly, since nothing reads a .env file automatically:
#   cd backend && uv run --env-file ../.env python -m agents.custom
#
# Every one of these is read server-side only. Nothing here may be prefixed with
# NEXT_PUBLIC_ - that would inline the value into the browser bundle.

# Model provider. The Anthropic SDK reads both of these from the environment on
# its own, so the client is constructed with no arguments. Pointed at DeepSeek's
# Anthropic-compatible endpoint rather than api.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Brave Search API, used by the web_search tool in services/. Without it the
# tool reports that search is not configured rather than failing the run.
# Key from https://api-dashboard.search.brave.com/register
BRAVE_SEARCH_API_KEY=

# Pinecone, used by the search_strategy tool in services/. Without it the
# tool reports that strategy search is not configured. The code looks up
# index pokeagent-strategy (override with PINECONE_STRATEGY_INDEX) in
# namespace strategy-v1.
PINECONE_API_KEY=

# TypeSafe Jev API, used only by the on-demand local tool-routing benchmark.
# It is not part of either runtime agent.
TYPESAFE_API_KEY=

# Lemon Squeezy, test mode only. Key names, never values.
# Create the key while the dashboard test-mode toggle is on.
# LEMONSQUEEZY_TEST_MODE must be the word true or checkout and webhooks refuse.
# The two variants are the $4.99 monthly and $49.99 yearly products.
# Docs checked 20 November 2026: https://docs.lemonsqueezy.com/help/getting-started/test-mode
LEMONSQUEEZY_TEST_MODE=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_MONTHLY=
LEMONSQUEEZY_VARIANT_YEARLY=
LEMONSQUEEZY_WEBHOOK_SECRET=
