# Copy to .env and fill in. .env is gitignored; this file holds key names only
# and must never contain a real value.
#
# Load it explicitly, since nothing reads a .env file automatically:
#   cd backend && uv run --env-file ../.env python -m agents.custom
#
# Every one of these is read server-side only. Nothing here may be prefixed with
# NEXT_PUBLIC_ - that would inline the value into the browser bundle.

# Model provider. The Anthropic SDK reads both of these from the environment on
# its own, so the client is constructed with no arguments. Pointed at DeepSeek's
# Anthropic-compatible endpoint rather than api.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Brave Search API, used by the web_search tool in services/. Without it the
# tool reports that search is not configured rather than failing the run.
# Key from https://api-dashboard.search.brave.com/register
BRAVE_SEARCH_API_KEY=

# TypeSafe Jev API, used only by the on-demand local tool-routing benchmark.
# It is not part of either runtime agent.
TYPESAFE_API_KEY=
