# Copy to .env.local and fill in. .env.local is gitignored; this file holds key
# names only and must never contain a real value.
#
# Every one of these is read server-side only. Nothing here may be prefixed with
# NEXT_PUBLIC_ — that would inline the value into the browser bundle.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
MODEL_NAME=
